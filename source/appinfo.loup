@mode(host.dual)

# Application identity for tsort: name, version, summary and exit statuses.
# Keep APP_NAME and APP_VERSION in step with `name` and `version` in
# package.lppkg.
#
# Runtime: host.dual. Constants only. Compiled into build/tsort by `make
# build`; `loup run source/main.loup` interprets the same code.

pub const APP_NAME: string = "tsort";
pub const APP_VERSION: string = "0.1.0";
pub const APP_SUMMARY: string = "Write a total order consistent with a partial order (a Loup recreation of GNU tsort).";

# Exit statuses returned by main(), as GNU tsort uses them.
pub const EXIT_OK: int = 0;
# The input contains a loop, cannot be read, or has an odd number of
# items; or the command line is wrong.
pub const EXIT_FAILURE: int = 1;
