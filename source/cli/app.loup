@mode(host.dual)

# Top level of tsort: parse the arguments, report an ArgError with GNU's
# hint, handle --help and --version, run the sort, and turn an exception
# that escapes (a bug) into a message and status 1.
#
# Runtime: host.dual. Compiled into the native binary build/tsort by `make
# build`; `loup run source/main.loup` interprets the same code, and the unit
# tests call run() directly.

from appinfo import (APP_NAME, EXIT_OK, EXIT_FAILURE);
from cli.args import (Options, ArgError, parse_args);
from cli.usage import (usage, version_line);
from commands.tsort import (run_tsort);

# Parses argv, runs tsort and returns the exit status.
pub func run(argv: list[string]): int {
    let opts = match parse_args(argv) {
        Ok(parsed) => parsed,
        Err(e) => {
            return report(e);
        },
    };
    if (opts.help) {
        println(usage());
        return EXIT_OK;
    }
    if (opts.version) {
        println(version_line());
        return EXIT_OK;
    }
    try {
        return run_tsort(opts);
    } catch (Exception as e) {
        printErr(APP_NAME + ": " + e.message);
        return EXIT_FAILURE;
    }
}

func report(e: ArgError): int {
    printErr(APP_NAME + ": " + e.message);
    if (e.try_help) {
        printErr("Try '" + APP_NAME + " --help' for more information.");
    }
    return EXIT_FAILURE;
}
