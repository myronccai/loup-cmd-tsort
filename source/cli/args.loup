@mode(host.dual)

# Command-line parsing for tsort, following GNU getopt as GNU tsort uses
# it:
#
# - `--help` and `--version`, also shortened (`--he`, `--v`); the first
#   of them that is reached wins, even after an operand;
# - the short options `-l` and `-q` of BSD tsort, which GNU's lacks; they
#   cluster (`-lq`);
# - any other option is an error: `-x` is an invalid option, `--x` an
#   unrecognized one;
# - `-` is an operand (standard input) and `--` ends the options;
# - at most one operand, the input file.
#
# Runtime: host.dual. Compiled into the native binary build/tsort by `make
# build`; `loup run source/main.loup` interprets the same code.

pub class Options {
    pub var help: bool = false;
    pub var version: bool = false;
    # -l: report the longest loop through the first stuck item.
    pub var longest: bool = false;
    # -q: do not report loops (the exit status still says there was one).
    pub var quiet: bool = false;
    # The input file; "-" is standard input.
    pub var file: string = "-";
}

# A command-line error: the message without `tsort: `, and whether the
# `Try 'tsort --help'` line follows it (it always does here).
pub class ArgError {
    pub let message: string;
    pub let try_help: bool;

    new(message: string, try_help: bool) {
        this.message = message;
        this.try_help = try_help;
    }
}

func long_names(): list[string] {
    return ["help", "version"];
}

func quoted(text: string): string {
    return "'" + text + "'";
}

pub func parse_args(argv: list[string]): Result[Options, ArgError] {
    let opts = Options();
    var operands: list[string] = [];
    var only_operands = false;
    for (arg in argv) {
        if (only_operands or arg == "-" or !arg.startsWith("-")) {
            operands.push(arg);
            continue;
        }
        if (arg == "--") {
            only_operands = true;
            continue;
        }
        if (!arg.startsWith("--")) {
            for (letter in arg.slice(1)) {
                if (letter == "l") {
                    safe {
                        opts.longest = true;
                    }
                } else if (letter == "q") {
                    safe {
                        opts.quiet = true;
                    }
                } else {
                    return Err(ArgError("invalid option -- " + quoted(letter), true));
                }
            }
            continue;
        }
        var name = arg.slice(2);
        var has_value = false;
        let eq = name.index_of("=");
        if (eq >= 0) {
            name = name.slice(0, eq);
            has_value = true;
        }
        var found: list[string] = [];
        for (long in long_names()) {
            if (long.startsWith(name)) {
                found.push(long);
            }
        }
        if (found.len() == 0) {
            return Err(ArgError("unrecognized option " + quoted(arg), true));
        }
        if (found.len() > 1 and !long_names().contains(name)) {
            return Err(ArgError("option " + quoted(arg) + " is ambiguous; possibilities: '--help' '--version'", true));
        }
        let long = if (found.len() == 1) { found[0] } else { name };
        if (has_value) {
            return Err(ArgError("option " + quoted("--" + long) + " doesn't allow an argument", true));
        }
        safe {
            if (long == "help") {
                opts.help = true;
            } else {
                opts.version = true;
            }
        }
        return Ok(opts);
    }
    if (operands.len() > 1) {
        return Err(ArgError("extra operand " + quoted(operands[1]), true));
    }
    if (operands.len() == 1) {
        safe {
            opts.file = operands[0];
        }
    }
    return Ok(opts);
}
