@mode(host.dual)

# Unit tests for tsort's argument parsing (cli.args): the operand, `-`,
# `--`, `--help` and `--version` with abbreviations, `-l` and `-q`, and
# getopt's messages.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this
# file with Stage0 (`loup-bootstrap test --no-parallel`, source/ on
# LOUPPATH), one test per `func test_*()`. It is not part of the binary.

from debug.assert import (expect, expectEq);
from cli.args import (Options, ArgError, parse_args);

func error_of(argv: list[string]): string {
    match parse_args(argv) {
        Ok(opts) => {
            return "";
        },
        Err(e) => {
            return e.message;
        },
    }
}

func test_no_arguments_reads_standard_input(): void {
    let none: list[string] = [];
    let opts = parse_args(none).unwrap();
    expectEq(opts.file, "-", "standard input");
    expect(!opts.help and !opts.version and !opts.longest and !opts.quiet, "nothing else");
}

func test_operand(): void {
    expectEq(parse_args(["deps.txt"]).unwrap().file, "deps.txt", "a file");
    expectEq(parse_args(["-"]).unwrap().file, "-", "- is standard input");
    expectEq(parse_args(["--", "-l"]).unwrap().file, "-l", "after -- an option is a file name");
}

func test_help_and_version(): void {
    expect(parse_args(["--help"]).unwrap().help, "--help");
    expect(parse_args(["--he"]).unwrap().help, "--he");
    expect(parse_args(["--v"]).unwrap().version, "--v");
    expect(parse_args(["a", "b", "--help"]).unwrap().help, "--help wins over extra operands");
    expect(parse_args(["--version", "--bogus"]).unwrap().version, "the first one wins");
}

func test_bsd_options(): void {
    let opts = parse_args(["-lq", "x"]).unwrap();
    expect(opts.longest and opts.quiet, "-lq");
    expectEq(opts.file, "x", "and the operand");
    expect(parse_args(["-q", "-l"]).unwrap().longest, "separately");
}

func test_errors(): void {
    expectEq(error_of(["-x"]), "invalid option -- 'x'", "unknown short option");
    expectEq(error_of(["-lx"]), "invalid option -- 'x'", "in a cluster");
    expectEq(error_of(["--bogus"]), "unrecognized option '--bogus'", "unknown long option");
    expectEq(error_of(["--help=1"]), "option '--help' doesn't allow an argument", "a value");
    expectEq(error_of(["--=1"]), "option '--=1' is ambiguous; possibilities: '--help' '--version'", "ambiguous");
    expectEq(error_of(["a", "b"]), "extra operand 'b'", "two files");
}
