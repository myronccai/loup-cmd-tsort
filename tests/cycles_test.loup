@mode(host.dual)

# Unit tests for commands.cycles (`-l`): Tarjan's strongly connected
# components of the waiting items and the longest-cycle search.
#
# Runtime: host.dual, run by the test runner: `make test` interprets this
# file with Stage0 (`loup-bootstrap test --no-parallel`, source/ on
# LOUPPATH), one test per `func test_*()`. It is not part of the binary.

from debug.assert import (expect, expectEq);
from commands.cycles import (Cycle, Components, components, longest_cycle);
from commands.order import (walk_order);
from commands.tsort import (relations_from);
from commands.graph import (Graph);

# The labels of a cycle, joined.
func cycle_text(g: Graph[string], c: Cycle): string {
    var parts: list[string] = [];
    for (node in c.nodes) {
        parts.push(g.label(node));
    }
    return parts.join(" ");
}

func graph_of(text: string): Graph[string] {
    return relations_from(text).graph;
}

func test_components(): void {
    # a <-> b form a component, c -> d -> c another, b -> c joins them one way.
    let g = graph_of("a b\nb a\nb c\nc d\nd c\nd e\n");
    let parts = components(g, walk_order(g));
    expectEq(parts.sizes.len(), 3, "{a, b}, {c, d}, {e}");
    expectEq(parts.of_node[0], parts.of_node[1], "a and b together");
    expectEq(parts.of_node[2], parts.of_node[3], "c and d together");
    expect(parts.of_node[0] != parts.of_node[2], "but apart from each other");
    expectEq(parts.sizes[parts.of_node[4]], 1, "e alone");
}

func test_written_items_are_left_out(): void {
    let g = graph_of("a b\nb c\n");
    safe {
        g.release(0);
    }
    let parts = components(g, walk_order(g));
    expectEq(parts.of_node[0], -1, "a is free, so it is in no component");
}

func test_longest_cycle(): void {
    let g = graph_of("a b\nb a\nb c\nc d\nd a\n");
    let c = longest_cycle(g, walk_order(g));
    expectEq(cycle_text(g, c), "a b c d", "the four-item loop, not a <-> b");
    expectEq(g.target(c.closing_edge), 0, "closed by the edge back to a");
}

func test_start_is_the_first_item_on_a_loop(): void {
    # a only leads into the loop; b is the first item on it.
    let g = graph_of("a b\nb c\nc b\n");
    let c = longest_cycle(g, walk_order(g));
    expectEq(cycle_text(g, c), "b c", "starts at b");
}

func test_no_cycle(): void {
    let g = graph_of("a b\nb c\n");
    expectEq(longest_cycle(g, walk_order(g)).nodes.len(), 0, "an acyclic graph has none");
}
